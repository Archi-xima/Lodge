<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.lodge.controller.ReceiptDialogController"
      style="-fx-background-color: #f1f5f9; -fx-padding: 24;" spacing="18" prefWidth="520">

    <VBox styleClass="receipt-paper" spacing="16">
        
        <!-- Header -->
        <VBox alignment="CENTER" spacing="4">
            <Label text="🏨 LODGE BILLING LAB" styleClass="receipt-header-title"/>
            <Label text="Mulungushi University • ICT261 Lab" styleClass="receipt-header-sub"/>
            <Label text="Official Guest Receipt" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1e3a8a;"/>
        </VBox>

        <Separator/>

        <!-- Metadata Row -->
        <HBox alignment="CENTER_LEFT" spacing="10">
            <VBox spacing="2" HBox.hgrow="ALWAYS">
                <Label text="BILL NUMBER" styleClass="receipt-key"/>
                <Label fx:id="billIdLabel" text="B003" styleClass="receipt-val" style="-fx-font-size: 16px; -fx-text-fill: #1e40af;"/>
            </VBox>
            <VBox spacing="2" alignment="TOP_RIGHT">
                <Label text="DATE &amp; TIME" styleClass="receipt-key"/>
                <Label fx:id="dateLabel" text="09/10/2026 02:30" styleClass="receipt-val"/>
            </VBox>
        </HBox>

        <Separator/>

        <!-- Guest Details -->
        <GridPane hgap="12" vgap="8">
            <columnConstraints>
                <ColumnConstraints minWidth="130" prefWidth="150"/>
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>

            <Label text="Guest Name:" styleClass="receipt-key" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <Label fx:id="guestNameLabel" text="John Phiri" styleClass="receipt-val" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Room Type:" styleClass="receipt-key" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <Label fx:id="roomTypeLabel" text="Deluxe" styleClass="receipt-val" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Nightly Rate:" styleClass="receipt-key" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <Label fx:id="rateLabel" text="K 550.00 / night" styleClass="receipt-val" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <Label text="Duration:" styleClass="receipt-key" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <Label fx:id="nightsLabel" text="5 nights" styleClass="receipt-val" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
        </GridPane>

        <Separator/>

        <!-- Itemized Financial Breakdown -->
        <GridPane hgap="12" vgap="8">
            <columnConstraints>
                <ColumnConstraints minWidth="180" prefWidth="220"/>
                <ColumnConstraints hgrow="ALWAYS" halignment="RIGHT"/>
            </columnConstraints>

            <Label text="Room Charge:" styleClass="receipt-key" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <Label fx:id="roomChargeLabel" text="K 2750.00" styleClass="receipt-val" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Discount (5+ nights):" styleClass="receipt-key" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <Label fx:id="discountLabel" text="- K 137.50 (5% off)" styleClass="receipt-val" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Extras:" styleClass="receipt-key" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <Label fx:id="extrasLabel" text="K 200.00" styleClass="receipt-val" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <Region styleClass="info-divider" GridPane.rowIndex="3" GridPane.columnSpan="2"/>

            <Label text="Total Charges:" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #0f172a;" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <Label fx:id="totalLabel" text="K 2812.50" styleClass="receipt-total-large" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

            <Label text="Amount Paid:" styleClass="receipt-key" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
            <Label fx:id="paidLabel" text="K 1000.00" styleClass="receipt-val" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

            <Label text="Balance Due:" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1e3a8a;" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
            <Label fx:id="balanceLabel" text="K 1812.50" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #dc2626;" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
        </GridPane>

        <!-- Status Badge -->
        <HBox alignment="CENTER" style="-fx-padding: 8 0;">
            <Label fx:id="statusBadgeLabel" text="BALANCE OUTSTANDING"/>
        </HBox>

        <Separator/>

        <!-- Notes & Staff -->
        <VBox spacing="4">
            <Label text="Notes / Remarks:" styleClass="receipt-key"/>
            <Label fx:id="notesLabel" text="Late check-in requested" wrapText="true" style="-fx-font-style: italic; -fx-text-fill: #334155;"/>
        </VBox>

        <Label fx:id="servedByLabel" text="Prepared by: Mr E Nyirenda" style="-fx-font-size: 11.5px; -fx-text-fill: #64748b;"/>
    </VBox>

    <!-- Close button -->
    <HBox alignment="CENTER_RIGHT" spacing="12">
        <Button fx:id="closeButton" text="Close Receipt" onAction="#handleClose" styleClass="btn-secondary"/>
    </HBox>

</VBox>
