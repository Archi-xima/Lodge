<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.lodge.controller.BillingController"
      spacing="16" styleClass="module-root">
    <padding>
        <Insets top="18" right="20" bottom="20" left="20"/>
    </padding>

    <VBox spacing="2">
        <Label text="Billing" styleClass="section-headline"/>
        <Label text="Walk-in invoices, extras, part payments and receipts. Double-click a bill to print it."
               styleClass="section-subheadline"/>
    </VBox>

    <HBox spacing="16" alignment="TOP_LEFT" VBox.vgrow="ALWAYS">

        <!-- ================= LEFT COLUMN ================= -->
        <VBox spacing="14" prefWidth="430" maxWidth="460" alignment="TOP_LEFT">

            <!-- Walk-in invoice -->
            <VBox styleClass="card-panel" spacing="9">
                <Label text="New walk-in invoice" styleClass="table-section-title"/>

                <Label text="Guest name" styleClass="form-field-label"/>
                <TextField fx:id="walkInGuestField" promptText="e.g. Mary Banda" styleClass="modern-text-field"/>

                <HBox spacing="10">
                    <VBox spacing="9" HBox.hgrow="ALWAYS">
                        <Label text="Phone" styleClass="form-field-label"/>
                        <TextField fx:id="walkInPhoneField" promptText="Optional" styleClass="modern-text-field"/>
                    </VBox>
                    <VBox spacing="9" HBox.hgrow="ALWAYS">
                        <Label text="Nights" styleClass="form-field-label"/>
                        <TextField fx:id="walkInNightsField" text="1" styleClass="modern-text-field"/>
                    </VBox>
                </HBox>

                <Label text="Room occupied" styleClass="form-field-label"/>
                <ComboBox fx:id="walkInRoomCombo" maxWidth="Infinity" styleClass="modern-combo-box"/>

                <Label text="Extras in K" styleClass="form-field-label"/>
                <TextField fx:id="walkInExtrasField" promptText="e.g. 200 (no discount on extras)" styleClass="modern-text-field"/>

                <Label text="Notes" styleClass="form-field-label"/>
                <TextField fx:id="walkInNotesField" promptText="Optional remarks" styleClass="modern-text-field"/>

                <Button fx:id="createInvoiceBtn" text="Create invoice" onAction="#handleCreateInvoice"
                        maxWidth="Infinity" styleClass="btn-primary" style="-fx-padding: 10;"/>
            </VBox>

            <!-- Invoices list -->
            <VBox styleClass="card-panel" spacing="10" VBox.vgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="Invoices" styleClass="table-section-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <TextField fx:id="billSearchField" promptText="Search bill, guest or room"
                               prefWidth="180" styleClass="modern-text-field"/>
                </HBox>
                <TableView fx:id="billsTable" styleClass="modern-table-view" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colBillId" text="Bill" prefWidth="70"/>
                        <TableColumn fx:id="colBillGuest" text="Guest" prefWidth="140"/>
                        <TableColumn fx:id="colBillRoom" text="Room" prefWidth="120"/>
                        <TableColumn fx:id="colBillTotal" text="Total" prefWidth="100"/>
                        <TableColumn fx:id="colBillPaid" text="Paid" prefWidth="100"/>
                        <TableColumn fx:id="colBillBalance" text="Balance" prefWidth="100"/>
                        <TableColumn fx:id="colBillStatus" text="Status" prefWidth="100"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Button fx:id="receiptBtn" text="🖨 Receipt" onAction="#handleViewReceipt" styleClass="btn-secondary"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="voidBillBtn" text="Void bill" onAction="#handleVoidBill" styleClass="toolbar-btn-danger"/>
                </HBox>
            </VBox>
        </VBox>

        <!-- ================= RIGHT COLUMN ================= -->
        <VBox spacing="14" HBox.hgrow="ALWAYS" alignment="TOP_LEFT">

            <!-- Invoice header -->
            <VBox styleClass="card-panel" spacing="8">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="Invoice" styleClass="table-section-title"/>
                    <Label fx:id="detailBillId" text="—" styleClass="chip-label"/>
                    <Label fx:id="detailStatus" text="—" styleClass="status-pill status-grey"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="detailCreated" text="—" styleClass="muted-text"/>
                </HBox>
                <HBox spacing="26">
                    <Label fx:id="detailGuest" text="Select an invoice" styleClass="detail-strong"/>
                    <Label fx:id="detailRoom" text="—" styleClass="muted-text"/>
                    <Label fx:id="detailStay" text="—" styleClass="muted-text"/>
                </HBox>
            </VBox>

            <!-- Lines and totals -->
            <HBox spacing="14" alignment="TOP_LEFT" VBox.vgrow="ALWAYS">
                <VBox spacing="10" HBox.hgrow="ALWAYS">
                    <Label text="Extra charges on this bill" styleClass="table-section-title"/>
                    <TableView fx:id="linesTable" styleClass="modern-table-view" prefHeight="220">
                        <columns>
                            <TableColumn fx:id="colLineDesc" text="Description" prefWidth="200"/>
                            <TableColumn fx:id="colLineCat" text="Category" prefWidth="110"/>
                            <TableColumn fx:id="colLineQty" text="Qty" prefWidth="60"/>
                            <TableColumn fx:id="colLineUnit" text="Unit price" prefWidth="110"/>
                            <TableColumn fx:id="colLineTotal" text="Amount" prefWidth="120"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <ComboBox fx:id="extraServiceCombo" prefWidth="230" styleClass="modern-combo-box"/>
                        <TextField fx:id="extraQtyField" promptText="Qty" prefWidth="60" styleClass="modern-text-field"/>
                        <Button fx:id="addExtraBtn" text="Add" onAction="#handleAddExtra" styleClass="btn-secondary"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="removeLineBtn" text="Remove line" onAction="#handleRemoveLine" styleClass="toolbar-btn-danger"/>
                    </HBox>

                    <Label text="Payments received" styleClass="table-section-title"/>
                    <TableView fx:id="paymentsTable" styleClass="modern-table-view" prefHeight="140">
                        <columns>
                            <TableColumn fx:id="colPaymentId" text="Ref" prefWidth="70"/>
                            <TableColumn fx:id="colPaymentDate" text="Date" prefWidth="150"/>
                            <TableColumn fx:id="colPaymentMethod" text="Method" prefWidth="130"/>
                            <TableColumn fx:id="colPaymentAmount" text="Amount" prefWidth="110"/>
                            <TableColumn fx:id="colPaymentRef" text="Reference" prefWidth="120"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>
                </VBox>

                <!-- Totals -->
                <VBox prefWidth="280" maxWidth="300" spacing="7" styleClass="card-panel totals-card">
                    <Label text="Summary" styleClass="table-section-title"/>

                    <HBox alignment="CENTER_RIGHT" spacing="10">
                        <Label text="Room charge" styleClass="muted-text"/>
                        <Label fx:id="roomChargeLabel" text="K 0.00" styleClass="totals-line"/>
                    </HBox>
                    <HBox alignment="CENTER_RIGHT" spacing="10">
                        <Label text="Long-stay discount" styleClass="muted-text"/>
                        <Label fx:id="discountLabel" text="K 0.00" styleClass="success-text"/>
                    </HBox>
                    <HBox alignment="CENTER_RIGHT" spacing="10">
                        <Label text="Extras" styleClass="muted-text"/>
                        <Label fx:id="extrasLabel" text="K 0.00" styleClass="totals-line"/>
                    </HBox>
                    <Separator/>
                    <HBox alignment="CENTER_RIGHT" spacing="10">
                        <Label text="Subtotal" styleClass="muted-text"/>
                        <Label fx:id="subtotalLabel" text="K 0.00" styleClass="totals-line"/>
                    </HBox>
                    <HBox alignment="CENTER_RIGHT" spacing="10">
                        <Label text="VAT" styleClass="muted-text"/>
                        <Label fx:id="taxLabel" text="K 0.00" styleClass="totals-line"/>
                    </HBox>
                    <Separator/>
                    <HBox alignment="CENTER_RIGHT" spacing="10">
                        <Label text="TOTAL" styleClass="totals-title"/>
                        <Label fx:id="totalLabel" text="K 0.00" styleClass="totals-grand"/>
                    </HBox>
                    <HBox alignment="CENTER_RIGHT" spacing="10">
                        <Label text="Paid" styleClass="muted-text"/>
                        <Label fx:id="paidLabel" text="K 0.00" styleClass="totals-line"/>
                    </HBox>
                    <HBox alignment="CENTER_RIGHT" spacing="10">
                        <Label text="BALANCE" styleClass="totals-title"/>
                        <Label fx:id="balanceLabel" text="K 0.00" styleClass="totals-balance"/>
                    </HBox>

                    <Separator/>
                    <Label text="Record a payment" styleClass="table-section-title"/>
                    <TextField fx:id="payAmountField" promptText="Amount in K" styleClass="modern-text-field"/>
                    <ComboBox fx:id="payMethodCombo" maxWidth="Infinity" styleClass="modern-combo-box"/>
                    <TextField fx:id="payReferenceField" promptText="Reference / till no." styleClass="modern-text-field"/>
                    <Button fx:id="recordPaymentBtn" text="Record payment" onAction="#handleRecordPayment"
                            maxWidth="Infinity" styleClass="btn-primary"/>
                </VBox>
            </HBox>

            <Label fx:id="statusLabel" text="" styleClass="muted-text"/>
        </VBox>
    </HBox>

</VBox>
