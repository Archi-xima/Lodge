<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.lodge.controller.MainController"
      prefWidth="1280" prefHeight="800" styleClass="app-root">

    <!-- ============================ HEADER ============================ -->
    <HBox styleClass="top-header-bar" alignment="CENTER_LEFT" spacing="16">
        <padding>
            <Insets top="10" right="16" bottom="10" left="18"/>
        </padding>

        <Label text="☀" styleClass="header-logo"/>
        <VBox spacing="1">
            <Label text="SkyRidge Lodge" styleClass="app-title-logo"/>
            <Label text="Billing &amp; Management System" styleClass="app-subtitle-logo"/>
        </VBox>

        <Region HBox.hgrow="ALWAYS"/>

        <Label fx:id="occupancyBadge" text="0% occupied" styleClass="header-chip"/>

        <MenuBar styleClass="header-menu">
            <Menu text="File">
                <MenuItem text="🧾 New walk-in invoice" onAction="#handleMenuNewInvoice"/>
                <MenuItem text="📅 New booking" onAction="#handleMenuNewBooking"/>
                <MenuItem text="🛏 Manage rooms" onAction="#handleMenuRooms"/>
                <SeparatorMenuItem/>
                <MenuItem text="🚪 Sign out" onAction="#handleSignOut"/>
                <MenuItem text="❌ Exit" onAction="#handleExit"/>
            </Menu>
            <Menu text="Help">
                <MenuItem text="🏷 Rates &amp; billing rules" onAction="#handlePricingRules"/>
                <MenuItem fx:id="auditTrailMenu" text="🧾 Audit trail" onAction="#handleAuditTrail"/>
                <MenuItem text="ℹ About" onAction="#handleAbout"/>
            </Menu>
        </MenuBar>

        <HBox alignment="CENTER" spacing="10" styleClass="user-chip">
            <VBox alignment="CENTER_RIGHT" spacing="1">
                <Label fx:id="currentUserLabel" text="Guest" styleClass="user-chip-name"/>
                <Label fx:id="userRoleBadge" text="Role" styleClass="user-chip-role"/>
            </VBox>
        </HBox>
    </HBox>

    <!-- ============================ BODY ============================ -->
    <BorderPane VBox.vgrow="ALWAYS">

        <!-- Sidebar navigation -->
        <left>
            <VBox styleClass="sidebar" spacing="4">
                <padding>
                    <Insets top="14" right="10" bottom="14" left="10"/>
                </padding>

                <Label text="OPERATIONS" styleClass="sidebar-heading"/>
                <Button fx:id="navDashboard" text="🏠  Dashboard" styleClass="nav-btn" maxWidth="Infinity"/>
                <Button fx:id="navRooms" text="🛏  Rooms" styleClass="nav-btn" maxWidth="Infinity"/>
                <Button fx:id="navBookings" text="📅  Reservations" styleClass="nav-btn" maxWidth="Infinity"/>
                <Button fx:id="navGuests" text="👥  Guest book" styleClass="nav-btn" maxWidth="Infinity"/>
                <Button fx:id="navUsers" text="👤  Staff accounts" styleClass="nav-btn" maxWidth="Infinity"/>

                <Label text="MONEY" styleClass="sidebar-heading" style="-fx-padding: 14 0 4 8;"/>
                <Button fx:id="navBilling" text="🧾  Billing" styleClass="nav-btn" maxWidth="Infinity"/>
                <Button fx:id="navAccounting" text="Accounting" styleClass="nav-btn" maxWidth="Infinity"/>
                <Button fx:id="navReports" text="📊  Reports" styleClass="nav-btn" maxWidth="Infinity"/>

                <Region VBox.vgrow="ALWAYS"/>

                <VBox styleClass="sidebar-card" spacing="4">
                    <Label text="Front desk tip" styleClass="sidebar-card-title"/>
                    <Label text="Double-click an invoice to open its printable receipt."
                           styleClass="sidebar-card-text" wrapText="true"/>
                </VBox>
            </VBox>
        </left>

        <!-- Content -->
        <center>
            <BorderPane>
                <center>
                    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                                styleClass="content-scroll">
                        <content>
                            <StackPane fx:id="contentPane" styleClass="content-pane"/>
                        </content>
                    </ScrollPane>
                </center>
                <bottom>
                    <HBox styleClass="status-bar" alignment="CENTER_LEFT" spacing="10">
                        <padding>
                            <Insets top="6" right="14" bottom="6" left="14"/>
                        </padding>
                        <Label text="✔ Ready" styleClass="status-ready"/>
                        <Label fx:id="statusLabel" text="" styleClass="status-bar-text"/>
                    </HBox>
                </bottom>
            </BorderPane>
        </center>
    </BorderPane>

</VBox>
