<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.lodge.controller.ReceiptDialogController"
      fx:id="receiptPane" prefWidth="470" spacing="10" styleClass="receipt-root">
    <padding>
        <Insets top="20" right="24" bottom="20" left="24"/>
    </padding>

    <!-- Lodge letterhead -->
    <VBox alignment="CENTER" spacing="2">
        <Label text="SkyRidge Lodge" styleClass="receipt-lodge-name"/>
        <Label text="Great East Road, Kabwe  •  +260 970 000 111" styleClass="receipt-lodge-line"/>
        <Label text="VAT Reg: 100234567  •  info@skylodge.example" styleClass="receipt-lodge-line"/>
        <Label text="OFFICIAL GUEST RECEIPT" styleClass="receipt-heading"/>
    </VBox>

    <Separator/>

    <!-- Meta -->
    <GridPane hgap="10" vgap="6">
        <columnConstraints>
            <ColumnConstraints prefWidth="110"/>
            <ColumnConstraints prefWidth="150" hgrow="ALWAYS"/>
            <ColumnConstraints prefWidth="80"/>
            <ColumnConstraints prefWidth="110" hgrow="ALWAYS"/>
        </columnConstraints>

        <Label text="Receipt no." styleClass="receipt-key" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <Label fx:id="billIdLabel" text="B000" styleClass="receipt-value" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label text="Date" styleClass="receipt-key" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
        <Label fx:id="dateLabel" text="" styleClass="receipt-value" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

        <Label text="Guest" styleClass="receipt-key" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <Label fx:id="guestLabel" text="" styleClass="receipt-value" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Label text="Phone" styleClass="receipt-key" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
        <Label fx:id="phoneLabel" text="—" styleClass="receipt-value" GridPane.rowIndex="1" GridPane.columnIndex="3"/>

        <Label text="Room" styleClass="receipt-key" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <Label fx:id="roomLabel" text="" styleClass="receipt-value" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        <Label text="Stay" styleClass="receipt-key" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
        <Label fx:id="stayLabel" text="" styleClass="receipt-value" GridPane.rowIndex="2" GridPane.columnIndex="3"/>
    </GridPane>

    <HBox alignment="CENTER">
        <Label fx:id="statusBadgeLabel" text="UNPAID" styleClass="status-pill"/>
    </HBox>

    <!-- Extras -->
    <Label text="Additional services" styleClass="receipt-section-title"/>
    <TableView fx:id="linesTable" styleClass="receipt-table" prefHeight="120" maxHeight="160">
        <columns>
            <TableColumn fx:id="colRDesc" text="Item" prefWidth="210"/>
            <TableColumn fx:id="colRQty" text="Qty" prefWidth="50"/>
            <TableColumn fx:id="colRUnit" text="Unit" prefWidth="90"/>
            <TableColumn fx:id="colRTotal" text="Amount" prefWidth="100"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <!-- Totals -->
    <GridPane hgap="10" vgap="6" styleClass="receipt-totals">
        <columnConstraints>
            <ColumnConstraints prefWidth="180"/>
            <ColumnConstraints prefWidth="120" hgrow="ALWAYS"/>
        </columnConstraints>

        <Label text="Room charge" styleClass="receipt-key" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <Label fx:id="roomChargeLabel" text="K 0.00" styleClass="receipt-amount" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Long-stay discount (5%)" styleClass="receipt-key" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <Label fx:id="discountLabel" text="K 0.00" styleClass="receipt-amount" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Extras" styleClass="receipt-key" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <Label fx:id="extrasLabel" text="K 0.00" styleClass="receipt-amount" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Subtotal" styleClass="receipt-key" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <Label fx:id="subtotalLabel" text="K 0.00" styleClass="receipt-amount" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="VAT 16%" styleClass="receipt-key" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <Label fx:id="taxLabel" text="K 0.00" styleClass="receipt-amount" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        <Label text="TOTAL" styleClass="receipt-total-key" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <Label fx:id="totalLabel" text="K 0.00" styleClass="receipt-total-amount" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

        <Label text="Amount paid" styleClass="receipt-key" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
        <Label fx:id="paidLabel" text="K 0.00" styleClass="receipt-amount" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

        <Label text="BALANCE DUE" styleClass="receipt-total-key" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
        <Label fx:id="balanceLabel" text="K 0.00" styleClass="receipt-balance-amount" GridPane.rowIndex="7" GridPane.columnIndex="1"/>
    </GridPane>

    <!-- Payments -->
    <Label text="Payments received" styleClass="receipt-section-title"/>
    <Label fx:id="paymentsLabel" text="No payments received yet." styleClass="receipt-lines" wrapText="true"/>

    <Separator/>

    <Label fx:id="notesLabel" text="No notes recorded" styleClass="receipt-notes" wrapText="true"/>
    <Label fx:id="servedByLabel" text="Prepared by: Reception" styleClass="receipt-served"/>

    <VBox alignment="CENTER" spacing="4">
        <Label text="Thank you for staying with us — safiri salama!" styleClass="receipt-thanks"/>
        <Label text="Goods once sold are not returnable. Prices in Zambian Kwacha."
               styleClass="receipt-fineprint" wrapText="true" alignment="CENTER"/>
    </VBox>

    <HBox alignment="CENTER" spacing="12" style="-fx-padding: 8 0 0 0;">
        <Label text="Receipt captured in the system — print this window from the OS if a paper copy is needed."
               styleClass="receipt-fineprint" wrapText="true"/>
        <Button fx:id="closeButton" text="Close" onAction="#handleClose" styleClass="btn-secondary"/>
    </HBox>

</VBox>
