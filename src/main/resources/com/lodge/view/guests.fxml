<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.lodge.controller.GuestsController"
      spacing="16" styleClass="module-root">
    <padding>
        <Insets top="18" right="20" bottom="20" left="20"/>
    </padding>

    <VBox spacing="2">
        <Label text="Guest book" styleClass="section-headline"/>
        <Label text="Profiles of every guest that stays at the lodge, used by reservations and billing."
               styleClass="section-subheadline"/>
    </VBox>

    <HBox spacing="16" alignment="TOP_LEFT" VBox.vgrow="ALWAYS">

        <!-- Guest form -->
        <VBox prefWidth="320" maxWidth="340" spacing="10" styleClass="card-panel" alignment="TOP_LEFT">
            <Label text="Guest details" styleClass="table-section-title"/>

            <Label text="Full name" styleClass="form-field-label"/>
            <TextField fx:id="nameField" promptText="e.g. John Phiri" styleClass="modern-text-field"/>

            <Label text="Phone" styleClass="form-field-label"/>
            <TextField fx:id="phoneField" promptText="+260 977 123 456" styleClass="modern-text-field"/>

            <Label text="Email" styleClass="form-field-label"/>
            <TextField fx:id="emailField" promptText="guest@example.com" styleClass="modern-text-field"/>

            <Label text="ID / Passport" styleClass="form-field-label"/>
            <TextField fx:id="idField" promptText="e.g. ZM1234567" styleClass="modern-text-field"/>

            <Label text="Nationality" styleClass="form-field-label"/>
            <TextField fx:id="nationalityField" promptText="e.g. Zambia" styleClass="modern-text-field"/>

            <Label text="Notes" styleClass="form-field-label"/>
            <TextField fx:id="notesField" promptText="Preferences, allergies, corporate account..." styleClass="modern-text-field"/>

            <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 6 0 0 0;">
                <Button fx:id="saveGuestBtn" text="Save guest" onAction="#handleSaveGuest" styleClass="btn-primary"/>
                <Button text="Clear" onAction="#handleClearForm" styleClass="btn-secondary"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="deleteGuestBtn" text="Delete" onAction="#handleDeleteGuest" styleClass="toolbar-btn-danger"/>
            </HBox>
        </VBox>

        <!-- Guest table -->
        <VBox spacing="10" styleClass="card-panel" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="14">
                <Label text="All guests" styleClass="table-section-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Search" styleClass="form-field-label"/>
                <TextField fx:id="searchField" promptText="Name, phone or email" prefWidth="240" styleClass="modern-text-field"/>
            </HBox>

            <TableView fx:id="guestsTable" styleClass="modern-table-view" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colGuestId" text="ID" prefWidth="70"/>
                    <TableColumn fx:id="colName" text="Full name" prefWidth="200"/>
                    <TableColumn fx:id="colPhone" text="Phone" prefWidth="160"/>
                    <TableColumn fx:id="colEmail" text="Email" prefWidth="220"/>
                    <TableColumn fx:id="colIdPassport" text="ID / Passport" prefWidth="130"/>
                    <TableColumn fx:id="colNationality" text="Nationality" prefWidth="120"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </HBox>

</VBox>
