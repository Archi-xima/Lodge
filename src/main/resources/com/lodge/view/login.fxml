<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.lodge.controller.LoginController"
           styleClass="auth-root-pane" prefWidth="900" prefHeight="650">

    <VBox alignment="CENTER" maxWidth="450" spacing="0">
        <VBox styleClass="auth-card" spacing="18">

            <!-- Brand Header -->
            <VBox alignment="CENTER" spacing="6">
                <Label text="🏨" style="-fx-font-size: 38px;"/>
                <Label text="Lodge Billing Lab" styleClass="auth-title"/>
                <Label text="Mulungushi University • ICT261 Lecture 3" styleClass="auth-subtitle"/>
            </VBox>

            <Separator/>

            <!-- SIGN IN FORM -->
            <VBox fx:id="signInForm" spacing="14">
                <VBox spacing="4">
                    <Label text="Sign In" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                    <Label text="Access the guest billing system" style="-fx-text-fill: #64748b; -fx-font-size: 12px;"/>
                </VBox>

                <VBox spacing="6">
                    <Label text="Username" styleClass="form-field-label"/>
                    <TextField fx:id="usernameField" promptText="e.g. admin or reception" styleClass="modern-text-field"/>
                </VBox>

                <VBox spacing="6">
                    <Label text="Password" styleClass="form-field-label"/>
                    <PasswordField fx:id="passwordField" promptText="Enter your password" styleClass="modern-text-field"/>
                </VBox>

                <!-- Demo Quick Fill Buttons -->
                <VBox spacing="6">
                    <Label text="Quick Demo Logins:" style="-fx-font-size: 11px; -fx-text-fill: #64748b; -fx-font-weight: bold;"/>
                    <HBox spacing="8">
                        <Button text="👤 Admin (Mr Nyirenda)" onAction="#handleDemoAdmin" styleClass="demo-chip-btn"/>
                        <Button text="🛎️ Receptionist" onAction="#handleDemoReception" styleClass="demo-chip-btn"/>
                    </HBox>
                </VBox>

                <Label fx:id="loginErrorLabel" wrapText="true" style="-fx-font-size: 12px;"/>

                <Button fx:id="signInButton" text="Sign In" onAction="#handleSignIn"
                        maxWidth="Infinity" styleClass="btn-primary" style="-fx-padding: 10 20;"/>

                <HBox alignment="CENTER" spacing="6">
                    <Label text="Need an account?" style="-fx-text-fill: #64748b; -fx-font-size: 12.5px;"/>
                    <Button text="Register here" onAction="#showSignUpView" styleClass="auth-link"/>
                </HBox>
            </VBox>

            <!-- SIGN UP FORM -->
            <VBox fx:id="signUpForm" spacing="14" visible="false" managed="false">
                <VBox spacing="4">
                    <Label text="Register Staff Account" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                    <Label text="Create a new system user profile" style="-fx-text-fill: #64748b; -fx-font-size: 12px;"/>
                </VBox>

                <VBox spacing="6">
                    <Label text="Full Name" styleClass="form-field-label"/>
                    <TextField fx:id="regFullNameField" promptText="e.g. Joseph Mwale" styleClass="modern-text-field"/>
                </VBox>

                <VBox spacing="6">
                    <Label text="Username" styleClass="form-field-label"/>
                    <TextField fx:id="regUsernameField" promptText="e.g. jmwale" styleClass="modern-text-field"/>
                </VBox>

                <VBox spacing="6">
                    <Label text="Password" styleClass="form-field-label"/>
                    <PasswordField fx:id="regPasswordField" promptText="Create a secure password" styleClass="modern-text-field"/>
                </VBox>

                <VBox spacing="6">
                    <Label text="Role" styleClass="form-field-label"/>
                    <ComboBox fx:id="regRoleComboBox" maxWidth="Infinity" styleClass="modern-combo-box"/>
                </VBox>

                <Label fx:id="regMessageLabel" wrapText="true" style="-fx-font-size: 12px;"/>

                <Button text="Create Account" onAction="#handleSignUp"
                        maxWidth="Infinity" styleClass="btn-primary" style="-fx-padding: 10 20;"/>

                <HBox alignment="CENTER" spacing="6">
                    <Label text="Already registered?" style="-fx-text-fill: #64748b; -fx-font-size: 12.5px;"/>
                    <Button text="Back to Sign In" onAction="#showSignInView" styleClass="auth-link"/>
                </HBox>
            </VBox>

        </VBox>
    </VBox>

</StackPane>
