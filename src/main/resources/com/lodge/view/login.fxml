<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.lodge.controller.LoginController"
      styleClass="auth-root-pane" prefWidth="1080" prefHeight="720" spacing="0">

    <!-- ==================== LEFT: PROPERTY PHOTO ==================== -->
    <StackPane prefWidth="560" minWidth="420" HBox.hgrow="ALWAYS" styleClass="auth-photo-pane">
        <ImageView fitWidth="760" fitHeight="720" preserveRatio="true" smooth="true">
            <image>
                <Image url="@../images/hero-lodge.jpg"/>
            </image>
        </ImageView>
        <VBox alignment="BOTTOM_LEFT" spacing="6" styleClass="auth-photo-overlay">
            <padding>
                <Insets top="40" right="40" bottom="46" left="46"/>
            </padding>
            <Label text="SkyRidge Lodge" styleClass="auth-photo-title"/>
            <Label text="Thatched suites, pool &amp; open-air restaurant" styleClass="auth-photo-sub"/>
            <Label text="Front desk • Reservations • Billing • Reports" styleClass="auth-photo-sub"/>
        </VBox>
    </StackPane>

    <!-- ==================== RIGHT: SIGN IN ==================== -->
    <ScrollPane fitToWidth="true" focusTraversable="false" HBox.hgrow="NEVER" prefWidth="480"
                styleClass="transparent-scroll">
        <VBox alignment="CENTER" maxWidth="480" styleClass="auth-card-holder">
            <padding>
                <Insets top="34" right="40" bottom="34" left="40"/>
            </padding>
            <VBox styleClass="auth-card" spacing="16">

                <VBox alignment="CENTER" spacing="4">
                    <Label text="🏨" styleClass="auth-emoji"/>
                    <Label text="Lodge Billing System" styleClass="auth-title"/>
                    <Label text="Sign in to manage lodge operations or book your stay" styleClass="auth-subtitle"/>
                </VBox>

                <Separator/>

                <!-- ========== SIGN IN FORM ========== -->
                <VBox fx:id="signInForm" spacing="12">
                    <Label text="Username" styleClass="form-field-label"/>
                    <TextField fx:id="usernameField" promptText="Enter your username" styleClass="modern-text-field"/>

                    <Label text="Password" styleClass="form-field-label"/>
                    <PasswordField fx:id="passwordField" promptText="Enter your password" styleClass="modern-text-field"/>
                    <Label fx:id="passwordStrengthLabel"
                           text="Password strength: —"
                           styleClass="muted-text"/>

                    <Label fx:id="loginErrorLabel" wrapText="true" styleClass="error-text"/>

                    <Button fx:id="signInButton" text="Sign in" onAction="#handleSignIn"
                            maxWidth="Infinity" styleClass="btn-primary" style="-fx-padding: 11 20;"/>

                    <Button text="Create a customer account" onAction="#handleShowCustomerRegistration"
                            styleClass="auth-link"/>

                </VBox>

                <VBox fx:id="customerRegistrationForm" spacing="12" visible="false" managed="false">
                    <Label text="Create your customer account" styleClass="auth-form-title"/>
                    <Label text="Sign up to browse rooms and book your stay." styleClass="muted-text" wrapText="true"/>
                    <Label text="Full name" styleClass="form-field-label"/>
                    <TextField fx:id="customerNameField" promptText="Your full name" styleClass="modern-text-field"/>
                    <Label text="Email" styleClass="form-field-label"/>
                    <TextField fx:id="customerEmailField" promptText="you@example.com" styleClass="modern-text-field"/>
                    <Label text="Phone (optional)" styleClass="form-field-label"/>
                    <TextField fx:id="customerPhoneField" promptText="Phone number" styleClass="modern-text-field"/>
                    <Label text="Username" styleClass="form-field-label"/>
                    <TextField fx:id="customerUsernameField" promptText="Choose a username" styleClass="modern-text-field"/>
                    <Label text="Password (8 characters minimum)" styleClass="form-field-label"/>
                    <PasswordField fx:id="customerPasswordField" promptText="Create a password" styleClass="modern-text-field"/>
                    <Label fx:id="customerRegistrationMessageLabel" wrapText="true"/>
                    <Button text="Create account and continue" onAction="#handleCreateCustomer"
                            maxWidth="Infinity" styleClass="btn-primary" style="-fx-padding: 11 20;"/>
                    <Button text="Back to sign in" onAction="#handleReturnToSignIn" styleClass="auth-link"/>
                </VBox>

                <!-- The first administrator is created once, then this setup form stays hidden. -->
                <VBox fx:id="adminSetupForm" spacing="12" visible="false" managed="false">
                    <Label text="Set up your administrator account" styleClass="auth-form-title"/>
                    <Label text="Create the lodge owner account before staff can sign in."
                           styleClass="muted-text" wrapText="true"/>
                    <Label text="Name" styleClass="form-field-label"/>
                    <TextField fx:id="adminNameField" text="Achizima" promptText="Your full name"
                               styleClass="modern-text-field"/>
                    <Label text="Username" styleClass="form-field-label"/>
                    <TextField fx:id="adminUsernameField" text="Achizima" promptText="Choose a username"
                               styleClass="modern-text-field"/>
                    <Label text="Password (8 characters minimum)" styleClass="form-field-label"/>
                    <PasswordField fx:id="adminPasswordField" promptText="Create your administrator password"
                                   styleClass="modern-text-field"/>
                    <Label fx:id="adminSetupMessageLabel" wrapText="true"/>
                    <Button fx:id="createAdminButton" text="Create administrator account"
                            onAction="#handleCreateAdministrator" maxWidth="Infinity"
                            styleClass="btn-primary" style="-fx-padding: 11 20;"/>
                </VBox>

            </VBox>
        </VBox>
    </ScrollPane>

</HBox>
